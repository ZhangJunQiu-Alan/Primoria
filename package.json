{
  "name": "primoria",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm -w run --parallel \"/^dev:/\"",
    "dev:agent": "pnpm --filter @primoria/agent dev",
    "dev:web": "pnpm --filter @primoria/web dev",
    "dev:worker": "pnpm --filter @primoria/web worker:lesson-generation",
    "dev:progress": "pnpm --filter @primoria/web worker:learning-progress",
    "dev:extractor": "pnpm --filter @primoria/web worker:extractor",
    "start": "pnpm -w run --parallel \"/^start:/\"",
    "start:agent": "pnpm --filter @primoria/agent start",
    "start:web": "pnpm --filter @primoria/web start",
    "start:worker": "pnpm --filter @primoria/web worker:lesson-generation",
    "start:progress": "pnpm --filter @primoria/web worker:learning-progress",
    "start:extractor": "pnpm --filter @primoria/web worker:extractor",
    "db:bootstrap": "pnpm --filter @primoria/web db:bootstrap && pnpm --filter @primoria/agent db:migrate",
    "db:initialize:kg": "pnpm --filter @primoria/web db:initialize:kg",
    "build": "pnpm --filter @primoria/web build",
    "audit:prod": "node scripts/audit-prod-bulk.mjs --audit-level high",
    "lint": "pnpm --filter @primoria/web lint",
    "typecheck": "pnpm --filter @primoria/web typecheck",
    "test:widget": "pnpm --filter @primoria/web test:widget",
    "test:widget:e2e": "pnpm --filter @primoria/web test:widget:e2e",
    "test:db": "pnpm --filter @primoria/web test:db",
    "test:agent": "pnpm --filter @primoria/agent test",
    "test:agent:integration": "pnpm --filter @primoria/agent test:integration",
    "generate:learning-goal-routing": "pnpm --filter @primoria/web generate:learning-goal-routing",
    "test:learning-goal-routing": "pnpm --filter @primoria/web test:learning-goal-routing",
    "eval:learning-goal-routing": "pnpm --filter @primoria/web eval:learning-goal-routing",
    "eval:tutor:validate": "pnpm --filter @primoria/agent eval:tutor:validate",
    "eval:tutor": "pnpm --filter @primoria/agent eval:tutor",
    "eval:tutor:zh:build": "pnpm --filter @primoria/agent eval:tutor:zh:build",
    "eval:tutor:zh:check": "pnpm --filter @primoria/agent eval:tutor:zh:check",
    "catalog:validate": "node scripts/validate-visualization-catalog.mjs",
    "agent:runs:status": "pnpm --filter @primoria/agent runs:admin status",
    "agent:runs:inspect": "pnpm --filter @primoria/agent runs:admin inspect",
    "agent:runs:cancel": "pnpm --filter @primoria/agent runs:admin cancel",
    "agent:runs:retry": "pnpm --filter @primoria/agent runs:admin retry",
    "agent:runs:recover": "pnpm --filter @primoria/agent runs:admin recover",
    "agent:runs:prune": "pnpm --filter @primoria/agent runs:admin prune",
    "test:learning-path:e2e": "node e2e/learning-path.smoke.mjs",
    "test:onboarding:e2e": "node e2e/onboarding.smoke.mjs",
    "test:tutor-runtime:e2e": "node e2e/tutor-runtime.smoke.mjs",
    "test:course-share:e2e": "node e2e/course-share.smoke.mjs",
    "test:regression:fast": "pnpm typecheck && pnpm lint && pnpm test && node --check apps/agent/src/graph.mjs && pnpm --filter @primoria/agent typecheck && pnpm test:agent && pnpm test:agent:integration && pnpm test:learning-goal-routing && pnpm eval:tutor:validate && pnpm eval:tutor:zh:check && pnpm catalog:validate && pnpm --filter @primoria/web test:interactive-routing && pnpm --filter @primoria/web validate:kg && pnpm --filter @primoria/web db:check:migrations",
    "test:regression:build": "pnpm build && pnpm --filter @primoria/web bundle:check",
    "test:regression:db": "pnpm --filter @primoria/web test:regression:db:isolated",
    "test:regression:browser": "pnpm --filter @primoria/web test:regression:browser:isolated",
    "test:regression:compose": "node scripts/run-production-compose-smoke.mjs",
    "test:regression": "pnpm test:regression:fast && pnpm test:regression:build && pnpm -w run --parallel \"/^test:regression:(db|browser)$/\"",
    "test": "pnpm --filter @primoria/web test"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "@ag-ui/langgraph@0.0.27": "0.0.42",
      "@babel/core@<7.29.6": "7.29.6",
      "dompurify@<3.4.11": "3.4.11",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "hono@<4.12.25": "4.12.25",
      "fast-uri@>=3.0.0 <4.0.0": "3.1.6",
      "ip-address@>=10.0.0 <11.0.0": "10.5.0",
      "nanoid@>=3.0.0 <4.0.0": "3.3.18",
      "postcss@>=8.0.0 <9.0.0": "8.5.26",
      "prismjs@<1.30.0": "1.30.0",
      "sharp@>=0.34.0 <0.35.0": "0.35.4",
      "undici@>=6.0.0 <7.0.0": "6.28.0",
      "undici@>=7.0.0 <8.0.0": "7.29.0",
      "uuid@>=10.0.0 <11.1.1": "11.1.1",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  }
}
