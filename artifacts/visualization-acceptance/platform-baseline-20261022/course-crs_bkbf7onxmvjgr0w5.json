            "html": "<div style=\"font-family:sans-serif;max-width:720px;margin:auto;padding:16px;border:1px solid #d7dee8;border-radius:10px;\"><div style=\"background:#eef3fb;border-left:4px solid #4a7dbd;padding:10px 12px;border-radius:6px;margin-bottom:14px;\"><strong>先预测：</strong>固定 U=6 V，若把 R 从 200 Ω 减半到 100 Ω，功率会怎样？<div style=\"margin-top:8px;\"><button data-ans=\"half\" onclick=\"predict(this)\">变为原来的 1/2</button> <button data-ans=\"same\" onclick=\"predict(this)\">基本不变</button> <button data-ans=\"double\" onclick=\"predict(this)\">变为原来的 2 倍</button> <button data-ans=\"quad\" onclick=\"predict(this)\">变为原来的 4 倍</button></div><div id=\"predictFeedback\" style=\"margin-top:6px;font-weight:bold;\"></div></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;\"><div style=\"background:#f8fafc;padding:12px;border-radius:8px;\"><label>电压 <i>U</i> = <span id=\"uVal\">6.0</span> V</label><input id=\"uSlider\" type=\"range\" min=\"0\" max=\"24\" step=\"0.1\" value=\"6\" oninput=\"updateAndDisplay()\" style=\"width:100%;\"><div style=\"margin-top:12px;\"></div><label>电阻 <i>R</i> = <span id=\"rVal\">200</span> Ω</label><input id=\"rSlider\" type=\"range\" min=\"1\" max=\"1000\" step=\"1\" value=\"200\" oninput=\"updateAndDisplay()\" style=\"width:100%;\"><div style=\"margin-top:12px;\"><button id=\"resetBtn\" onclick=\"resetEnergy()\">重置累计电能</button></div></div><div style=\"background:#0f1e2e;color:#eaf2fb;padding:14px;border-radius:8px;\"><div>电流 <i>I</i> = <span id=\"iVal\">0.030</span> A</div><div style=\"margin-top:8px;\">P = UI = <span id=\"pUI\">0.18</span> W</div><div>P = U²/R = <span id=\"pU2R\">0.18</span> W</div><div style=\"margin-top:8px;\">累计电能 W = <span id=\"wVal\">0.00</span> J</div><div id=\"statusBox\" style=\"margin-top:10px;padding:8px;border-radius:6px;background:#1f7a3d;color:white;\">安全</div><div style=\"margin-top:8px;opacity:.75;font-size:12px;\">额定功率按 0.25 W 判断</div></div></div><script>let W=0,lastTime=null;const RATED=0.25;function currentValues(){const U=parseFloat(document.getElementById('uSlider').value);const R=parseFloat(document.getElementById('rSlider').value);return {U,R,I:U/R,P:U*U/R};}function updateAndDisplay(){const {U,R,I,P}=currentValues();document.getElementById('uVal').textContent=U.toFixed(1);document.getElementById('rVal').textContent=Math.round(R);document.getElementById('iVal').textContent=I.toFixed(3);document.getElementById('pUI').textContent=P.toFixed(2);document.getElementById('pU2R').textContent=P.toFixed(2);const s=document.getElementById('statusBox');if(P>RATED){s.textContent='超过额定功率，有烧毁风险！';s.style.background='#c73e3e';}else if(P>=0.8*RATED){s.textContent='接近额定功率，请注意';s.style.background='#e08c2e';}else{s.textContent='工作在安全功率范围';s.style.background='#1f7a3d';}}function tick(){const now=performance.now();if(lastTime===null){lastTime=now;return;}const dt=(now-lastTime)/1000;lastTime=now;const {P}=currentValues();W+=P*dt;document.getElementById('wVal').textContent=W.toFixed(2);}function resetEnergy(){W=0;lastTime=performance.now();document.getElementById('wVal').textContent='0.00';}function predict(btn){const correct=btn.dataset.ans==='double';const fb=document.getElementById('predictFeedback');if(correct){fb.textContent='正确！P=U²/R，在 U 不变时 R 减半，P 变为原来的 2 倍。';fb.style.color='#1f7a3d';}else{fb.textContent='再想想：固定 U 时 P=U²/R，R 减半会让分母变小，功率会增大多少？';fb.style.color='#c04000';}}updateAndDisplay();setInterval(tick,100);lastTime=performance.now();</script></div>",
