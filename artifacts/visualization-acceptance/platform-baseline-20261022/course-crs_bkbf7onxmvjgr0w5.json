splay:block;'></canvas><p id='note' class='note'>先选择你的预测，然后拖动滑块验证。</p><script>(function(){var E=12,r=2;var slider=document.getElementById('Rslider');var Rval=document.getElementById('Rval');var Ival=document.getElementById('Ival');var Uval=document.getElementById('Uval');var Urval=document.getElementById('Urval');var note=document.getElementById('note');var canvas=document.getElementById('graph');var ctx=canvas.getContext('2d');function RfromSlider(v){return 0.1*Math.pow(10,4*v/4000);}function sliderFromR(R){return 4000*Math.log10(R/0.1)/4;}function update(){var v=Number(slider.value);var R=RfromSlider(v);var I=E/(R+r);var U=E-I*r;var Ur=I*r;Rval.textContent=R>=100?R.toFixed(0):(R>=10?R.toFixed(1):R.toFixed(2));Ival.textContent=I.toFixed(3);Uval.textContent=U.toFixed(2);Urval.textContent=Ur.toFixed(2);if(R>50){note.textContent='接近断路：R 很大，I≈0，U 趋近 E=12 V。';}else if(R<0.5){note.textContent='接近短路：R 很小，I≈E/r=6 A，U 趋近 0。';}else{note.textContent='R='+Rval.textContent+' Ω 时，I=E/(R+r)，U=E−Ir。';}draw(I,U,R);}function draw(I,U,R){var W=canvas.width,H=canvas.height;ctx.clearRect(0,0,W,H);var pad={l:70,r:30,t:30,b:50};var plotW=W-pad.l-pad.r,plotH=H-pad.t-pad.b;var Imax=E/r;var Umax=E;function px(I){return pad.l+I/Imax*plotW;}function py(U){return pad.t+(1-U/Umax)*plotH;}ctx.strokeStyle='#334e68';ctx.fillStyle='#334e68';ctx.lineWidth=1.2;ctx.beginPath();ctx.moveTo(pad.l,pad.t);ctx.lineTo(pad.l,H-pad.b);ctx.lineTo(W-pad.r,H-pad.b);ctx.stroke();ctx.font='12px system-ui';ctx.textAlign='center';for(var I=0;I<=6;I+=1){var x=px(I);ctx.beginPath();ctx.moveTo(x,H-pad.b);ctx.lineTo(x,H-pad.b+5);ctx.stroke();ctx.fillText(String(I),x,H-pad.b+18);}for(var U=0;U<=12;U+=3){var y=py(U);ctx.beginPath();ctx.moveTo(pad.l,y);ctx.lineTo(pad.l-5,y);ctx.stroke();ctx.textAlign='right';ctx.fillText(String(U),pad.l-8,y+4);ctx.textAlign='center';}ctx.fillText('I / A',pad.l+plotW/2,H-10);ctx.fillText('U / V',22,pad.t+plotH/2);ctx.strokeStyle='#2c7be5';ctx.lineWidth=2.5;ctx.setLineDash([]);ctx.beginPath();ctx.moveTo(px(0),py(E));ctx.lineTo(px(Imax),py(0));ctx.stroke();ctx.fillStyle='#627d98';ctx.font='12px system-ui';ctx.textAlign='left';ctx.fillText('断路点 (I≈0, U≈E)',px(0.15),py(E)-8);ctx.textAlign='right';ctx.fillText('短路点 (I≈E/r, U≈0)',px(5.85),py(0.5)+12);ctx.fillStyle='#d64545';ctx.beginPath();ctx.arc(px(I),py(U),7,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(px(I),py(U),2.5,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#9fb3c8';ctx.setLineDash([4,4]);ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(px(I),py(U));ctx.lineTo(px(I),H-pad.b);ctx.moveTo(px(I),py(U));ctx.lineTo(pad.l,py(U));ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='#334e68';ctx.font='13px system-ui';ctx.textAlign='left';ctx.fillText('('+I.toFixed(2)+' A, '+U.toFixed(2)+' V)',Math.min(px(I)+10,W-130),Math.max(py(U)-10,16));}slider.addEventListener('input',update);document.getElementById('shortBtn').addEventListener('click',function(){slider.value=sliderFromR(0.1);update();});document.getElementById('openBtn').addEventListener('click',function(){slider.value=4000;update();});var feedback=document.getElementById('predictFeedback');document.querySelectorAll('[data-predict]').forEach(function(btn){btn.addEventListener('click',function(){if(btn.getAttribute('data-predict')==='up'){feedback.innerHTML='✅ 正确：R 增大时 I 减小，内电压 Ir 减小，U=E−Ir 增大并趋近 E。';feedback.style.color='#1e7d46';}else if(btn.getAttribute('data-predict')==='down'){feedback.innerHTML='❌ 再想想：I 会随 R 增大而减小，内电压 Ir 会怎样变化？';feedback.style.color='#b42318';}else{feedback.innerHTML='❌ 不是不变：U=E−Ir，I 变化时 U 也会变化。';feedback.style.color='#b42318';}});});slider.value=sliderFromR(4);update();})();</script></div>",
