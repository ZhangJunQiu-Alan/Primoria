OPENAI_BASE_URL=https://ai.orbitlink.me/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5.4

# Shared cloud database.
# Use the Supabase Dashboard Connect panel, copy the Session Pooler URI, replace
# [YOUR-PASSWORD], and keep this value in apps/web/.env.local or deployment env.
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@[pooler-host].pooler.supabase.com:5432/postgres

# Optional workspace DeepAgent runtime.
# Production requires postgres persistence, DATABASE_URL, and real provider credentials.
PRIMORIA_WORKSPACE_DEEPAGENT=0
PRIMORIA_WORKSPACE_DEEPAGENT_PERSISTENCE=memory
# PRIMORIA_WORKSPACE_DEEPAGENT_POSTGRES_SCHEMA=primoria_deepagent
# Required to read /api/workspaces/agent-runtime/health in production.
# PRIMORIA_WORKSPACE_OPERATOR_TOKEN=replace-with-a-long-random-token
