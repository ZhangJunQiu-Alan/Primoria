OPENAI_BASE_URL=https://ai.orbitlink.me/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5.4
KG_EMBEDDING_PROVIDER=openai-compatible
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KG_EMBEDDING_MODEL_VERSION=openai:text-embedding-3-small:1536

# Optional: use MiniMax native embeddings instead of OpenAI-compatible embeddings.
# KG_EMBEDDING_PROVIDER=minimax
# MINIMAX_API_KEY=replace-with-your-minimax-open-platform-key
# MINIMAX_GROUP_ID=replace-with-your-minimax-group-id
# MINIMAX_EMBEDDING_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_EMBEDDING_MODEL=embo-01
# KG_EMBEDDING_MODEL_VERSION=minimax:embo-01:1536

# Local development uses an SSH tunnel to the private Tencent Cloud Postgres:
# ssh -N -L 15432:127.0.0.1:5432 ubuntu@<server>
DATABASE_URL=postgresql://primoria_app:[YOUR-PASSWORD]@127.0.0.1:15432/primoria
# Local tunnel/same-server connections normally do not need SSL. Use
# DATABASE_SSL=require only for remote direct connections to SSL-required DBs.
DATABASE_SSL=false

# Cold-start entry positioning (route B, block 4). Tune from logged real queries.
KG_POSITION_TAU=0.6
KG_POSITION_FLOOR=0.28
KG_BROAD_MENU_SIMILARITY_WINDOW=0.1

# Cold-start KG routing (coarse "which subject" step). A small/fast model picks
# the subject among the recalled candidates. This is the only subject-selection
# mechanism: if it cannot pick (error or no candidate fits), cross-graph cold-start
# returns the "be more specific" fallback. Set KG_ROUTER_MODEL to the exact model
# id on your endpoint (e.g. a small MiniMax model); leave empty to use OPENAI_MODEL.
KG_ROUTER_MODEL=
# KG_ROUTER_DEBUG=1  # log candidates + picked graph for tuning

# App auth is backed by the same Postgres database (users/identities/sessions).
# Supabase URL/anon/service-role keys are no longer required for Primoria.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_IP_MAX=5
AUTH_RATE_LIMIT_ACCOUNT_MAX=5
