OPENAI_BASE_URL=https://ai.orbitlink.me/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5.4
KG_EMBEDDING_PROVIDER=openai-compatible
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KG_EMBEDDING_MODEL_VERSION=openai:text-embedding-3-small:1536

# OpenRouter uses a provider-qualified model slug. Keep the model version
# distinct so vectors from different providers are never mixed.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
# KG_EMBEDDING_MODEL_VERSION=openrouter:openai/text-embedding-3-small:1536

# Optional: use MiniMax native embeddings instead of OpenAI-compatible embeddings.
# KG_EMBEDDING_PROVIDER=minimax
# MINIMAX_API_KEY=replace-with-your-minimax-open-platform-key
# MINIMAX_GROUP_ID=replace-with-your-minimax-group-id
# MINIMAX_EMBEDDING_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_EMBEDDING_MODEL=embo-01
# KG_EMBEDDING_MODEL_VERSION=minimax:embo-01:1536

# Local development defaults to the Docker Compose Postgres service.
# Start it with: docker compose up -d postgres
DATABASE_URL=postgresql://primoria_app:primoria_dev@127.0.0.1:5432/primoria
# Local Docker/same-server connections normally do not need SSL. Use
# DATABASE_SSL=require only for remote direct connections to SSL-required DBs.
DATABASE_SSL=disable

# Cold-start entry positioning (route B, block 4). Tune from logged real queries.
KG_POSITION_TAU=0.6
KG_POSITION_FLOOR=0.28
KG_BROAD_MENU_SIMILARITY_WINDOW=0.1

# Cold-start KG routing (coarse "which subject" step). A small/fast model picks
# the subject among the recalled candidates. This is the only subject-selection
# mechanism: if it cannot pick (error or no candidate fits), cross-graph cold-start
# returns the "be more specific" fallback. Set KG_ROUTER_MODEL to the exact model
# id on your endpoint (e.g. a small MiniMax model); leave empty to use OPENAI_MODEL.
KG_ROUTER_MODEL=
# KG_ROUTER_DEBUG=1  # log candidates + picked graph for tuning

# Local/dev only: allow a missing-KG-schema error (Postgres 42P01) to degrade
# into the freeform out-of-library path instead of failing. Other KG
# infrastructure failures (DB down, embedding provider down) never degrade.
# Leave unset in production. GET /api/health reports degraded KG state.
# PRIMORIA_ALLOW_KG_INFRA_FALLBACK=1

# App auth is backed by the same Postgres database (users/identities/sessions).
# Supabase URL/anon/service-role keys are no longer required for Primoria.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_IP_MAX=5
AUTH_RATE_LIMIT_ACCOUNT_MAX=5
# Only enable when your edge/proxy overwrites client-supplied forwarding headers.
AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS=false

# Password reset emails use Tencent Cloud SES SendEmail with an approved
# template. Template variables provided by Primoria:
# resetUrl/reset_url, expiresMinutes/expires_minutes, productName/product_name.
APP_BASE_URL=http://localhost:3000
EMAIL_PROVIDER=tencent-ses
TENCENT_SES_SECRET_ID=replace-with-secret-id
TENCENT_SES_SECRET_KEY=replace-with-secret-key
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_ENDPOINT=ses.tencentcloudapi.com
TENCENT_SES_FROM_EMAIL="Primoria <noreply@example.com>"
TENCENT_SES_PASSWORD_RESET_TEMPLATE_ID=123456
TENCENT_SES_PASSWORD_RESET_SUBJECT="Reset your Primoria password"
PASSWORD_RESET_EXPIRES_MINUTES=30
