OPENAI_BASE_URL=https://ai.orbitlink.me/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KG_EMBEDDING_MODEL_VERSION=openai:text-embedding-3-small:1536
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Cold-start entry positioning (route B, block 4). Tune from logged real queries.
KG_POSITION_TAU=0.6
KG_POSITION_FLOOR=0.28

# Supabase Auth (Phase 1). From Supabase Dashboard -> Project Settings -> API.
# Until these are set, auth is disabled (middleware/API guards pass through).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only; never exposed to the client. Used for admin/migration tasks.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Phase 2 hardening. Cloudflare Turnstile site key (public). When set, the
# captcha widget shows on login/signup and a token is sent to Supabase — enable
# CAPTCHA in the Supabase dashboard (with the matching secret) at the same time.
# Leave unset to keep captcha off. Google OAuth needs no client env (dashboard only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared cloud database.
# Use the Supabase Dashboard Connect panel, copy the Session Pooler URI, replace
# [YOUR-PASSWORD], and keep this value in apps/web/.env.local or deployment env.
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@[pooler-host].pooler.supabase.com:5432/postgres

# Optional workspace DeepAgent runtime.
# Production requires postgres persistence, DATABASE_URL, and real provider credentials.
PRIMORIA_WORKSPACE_DEEPAGENT=0
PRIMORIA_WORKSPACE_DEEPAGENT_PERSISTENCE=memory
# PRIMORIA_WORKSPACE_DEEPAGENT_POSTGRES_SCHEMA=primoria_deepagent
# Required to read /api/workspaces/agent-runtime/health in production.
# PRIMORIA_WORKSPACE_OPERATOR_TOKEN=replace-with-a-long-random-token

