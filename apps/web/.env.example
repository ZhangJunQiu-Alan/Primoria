OPENAI_BASE_URL=https://ai.orbitlink.me/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KG_EMBEDDING_MODEL_VERSION=openai:text-embedding-3-small:1536
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# Cold-start entry positioning (route B, block 4). Tune from logged real queries.
KG_POSITION_TAU=0.6
KG_POSITION_FLOOR=0.28

# Supabase Auth (Phase 1). From Supabase Dashboard -> Project Settings -> API.
# Until these are set, auth is disabled (middleware/API guards pass through).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only; never exposed to the client. Used for admin/migration tasks.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Phase 2 hardening. Cloudflare Turnstile site key (public). When set, the
# captcha widget shows on login/signup and a token is sent to Supabase — enable
# CAPTCHA in the Supabase dashboard (with the matching secret) at the same time.
# Leave unset to keep captcha off. Google OAuth needs no client env (dashboard only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
