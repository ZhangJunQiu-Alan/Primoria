{
  "name": "@primoria/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "if [ -f .env.local ]; then set -a; . ./.env.local; set +a; fi; next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:widget": "tsx tests/widget-export.unit.ts && tsx tests/stem-code.unit.ts",
    "test:kg": "tsx tests/knowledge-graph-query.unit.ts && tsx tests/knowledge-graph-positioning.unit.ts && tsx tests/position-learning-goal.unit.ts && tsx tests/course-branch-static.unit.ts && tsx tests/course-kg-context.unit.ts",
    "build:topic-graph": "node scripts/build-topic-graph.mjs",
    "calibrate:kg-floor": "node scripts/calibrate-kg-floor.mjs",
    "db:migrate:auth": "node scripts/migrate-auth.mjs",
    "db:migrate:courses": "node scripts/migrate-courses.mjs",
    "db:migrate:kg": "node scripts/migrate-kg.mjs",
    "db:seed:kg": "node scripts/seed-kg.mjs",
    "db:seed:kg-cross": "node scripts/seed-kg-cross.mjs",
    "db:seed:kg-embeddings": "node scripts/seed-kg-embeddings.mjs",
    "db:seed:kg-all": "node scripts/seed-kg.mjs all && node scripts/seed-kg-cross.mjs",
    "db:sync:kg": "pnpm db:migrate:kg && pnpm db:seed:kg && pnpm db:seed:kg-embeddings",
    "test:widget:e2e": "node tests/widget-renderer.e2e.mjs"
  },
  "dependencies": {
    "@copilotkit/react-core": "next",
    "@copilotkit/react-ui": "next",
    "@copilotkit/runtime": "next",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.3.1",
    "@langchain/openai": "^1.4.6",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "deepagents": "^1.10.2",
    "katex": "^0.17.0",
    "langchain": "^1.4.1",
    "next": "16.1.6",
    "pg": "^8.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "typescript": "^5.7.0"
  }
}
