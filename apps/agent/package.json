{
  "name": "@primoria/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "if [ -f .env ]; then set -a; . ./.env; set +a; fi; pnpm db:migrate && node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "db:migrate": "node src/runtime/migrate.mjs",
    "runs:admin": "node src/runtime/admin.mjs",
    "typecheck": "tsc --noEmit",
    "test:course-store": "node tests/course-store-schema.unit.mjs",
    "test:context-trim": "node tests/context-trim.unit.mjs",
    "test:agui-events": "node tests/agui-events.unit.mjs",
    "test:interactive-tool": "node tests/interactive-tool.unit.mjs",
    "test:internal-auth": "node tests/internal-auth.unit.mjs",
    "test:interactive-routing-contract": "node tests/interactive-routing-contract.unit.mjs",
    "test:tutor-benchmark": "node tests/tutor-benchmark.unit.mjs",
    "test:runtime-worker": "node tests/runtime-worker.unit.mjs",
    "test:graph-e2e": "node tests/graph-invoke.e2e.mjs",
    "test:runtime:db": "node tests/runtime-store.db.mjs && node tests/runtime-server.db.e2e.mjs",
    "test": "pnpm test:course-store && pnpm test:context-trim && pnpm test:agui-events && pnpm test:interactive-tool && pnpm test:internal-auth && pnpm test:interactive-routing-contract && pnpm test:tutor-benchmark && pnpm test:runtime-worker",
    "eval:tutor:validate": "node scripts/run-tutor-benchmark.mjs --validate-only",
    "eval:tutor": "if [ -f .env ]; then set -a; . ./.env; set +a; fi; node scripts/run-tutor-benchmark.mjs",
    "eval:tutor:zh:build": "node scripts/build-chinese-tutor-benchmark.mjs",
    "eval:tutor:zh:check": "node scripts/build-chinese-tutor-benchmark.mjs --check",
    "test:integration": "pnpm test:graph-e2e"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.52",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.3.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@langchain/openai": "^1.4.6",
    "@primoria/contracts": "workspace:*",
    "deepagents": "^1.10.2",
    "langchain": "^1.4.1",
    "pg": "^8.21.0",
    "zod": "^3.23.8",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.7.0"
  }
}
