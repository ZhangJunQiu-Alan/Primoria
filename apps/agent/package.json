{
  "name": "@primoria/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "if [ -f .env ]; then set -a; . ./.env; set +a; fi; langgraphjs dev --config ../../langgraph.json --host 127.0.0.1 --no-browser",
    "typecheck": "tsc --noEmit",
    "test:course-store": "node tests/course-store-schema.unit.mjs",
    "test:context-trim": "node tests/context-trim.unit.mjs",
    "test:graph-e2e": "node tests/graph-invoke.e2e.mjs",
    "test": "pnpm test:course-store && pnpm test:context-trim",
    "test:integration": "pnpm test:graph-e2e"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.3.1",
    "@langchain/openai": "^1.4.6",
    "@primoria/contracts": "workspace:*",
    "deepagents": "^1.10.2",
    "langchain": "^1.4.1",
    "zod": "^3.23.8",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.2.2",
    "@types/node": "^20",
    "typescript": "^5.7.0"
  }
}
