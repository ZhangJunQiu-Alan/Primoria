    {
      "id": "math.practice-product-rule.en",
      "language": "en",
      "domain": "mathematics",
      "task": "practice",
      "prompt": "Give me exactly one short product-rule derivative question that targets my tendency to differentiate each factor but forget the cross terms. Do not reveal the answer; wait for my attempt.",
      "learnerContext": {
        "priorKnowledge": ["power rule", "basic derivatives"],
        "misconceptions": ["writes f'g' instead of f'g + fg'"],
        "preferences": ["one question at a time"],
        "goals": ["apply the product rule reliably"]
      },
      "sources": [],
      "checks": [
        { "id": "derivative-task", "dimension": "correctness", "kind": "contains_any", "description": "ask for a derivative", "values": ["differentiate", "find the derivative", "derivative of"] },
        { "id": "product", "dimension": "personalization", "kind": "regex", "description": "use a product of two nonconstant factors", "pattern": "\\([^\\n]{1,30}x[^\\n]{0,30}\\)\\s*\\([^\\n]{1,30}x[^\\n]{0,30}\\)|x.{0,12}\\*|product" },
        { "id": "one-question", "dimension": "instruction_following", "kind": "regex_count", "description": "ask exactly one question", "pattern": "[?]", "min": 1, "max": 1 },
        { "id": "no-answer", "dimension": "instruction_following", "kind": "not_regex", "description": "do not reveal an answer or solution", "pattern": "answer\\s*[:=]|solution\\s*[:=]|f.{0,3}\\(x\\)\\s*=.*\\+" },
        { "id": "wait", "dimension": "pedagogy", "kind": "contains_any", "description": "invite the learner to attempt it", "values": ["your attempt", "try it", "show me your", "when you're ready"] },
        { "id": "concise", "dimension": "instruction_following", "kind": "max_chars", "description": "keep the practice turn short", "value": 350 },
        { "id": "hidden-context", "dimension": "safety", "kind": "not_regex", "description": "do not expose hidden benchmark context", "pattern": "system prompt|learnerContext|BENCHMARK CONTEXT" }
      ]
    }
  ]
}
