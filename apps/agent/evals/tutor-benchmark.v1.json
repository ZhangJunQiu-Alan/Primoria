        { "id": "quantity", "dimension": "correctness", "kind": "regex", "description": "equilibrium quantity rises", "pattern": "quantity.{0,20}(rise|increase|higher)|higher.{0,12}quantity" },
        { "id": "supply-fixed", "dimension": "correctness", "kind": "contains_any", "description": "hold supply fixed", "values": ["supply unchanged", "unchanged supply", "fixed supply"] },
