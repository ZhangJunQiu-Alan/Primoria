        { "id": "mechanism", "dimension": "correctness", "kind": "contains_any", "description": "说明选择透过性膜和水势差", "values": ["选择透过性膜", "水势较高", "水势差"] },
        { "id": "citation", "dimension": "source_faithfulness", "kind": "citation_ids", "description": "用标准格式引用 B1", "ids": ["B1"] },
        { "id": "misconception", "dimension": "personalization", "kind": "contains_any", "description": "澄清是水的净移动而非糖主动推水", "values": ["水的净移动", "不是糖主动", "并非糖把水推出"] },
        { "id": "direction-first", "dimension": "instruction_following", "kind": "regex", "description": "开头先给出移动方向", "pattern": "^.{0,45}(细胞内向外|移出细胞|进入糖水|细胞会失水)" },
