          "showLabels"
        ],
        "default": {
          "division": "mitosis",
          "stage": 2,
          "homologPairs": 2,
          "showLabels": true
        }
      },
      "patchHints": [
        {
          "zh-CN": "只修改用户要求的教学参数，其余字段保留。",
          "en": "Patch only the requested teaching parameters and preserve the rest."
        },
        {
          "zh-CN": "有丝stage0复制前/1复制后/2中期/3后期/4胞质分裂/5子细胞；减数stage0复制前/1复制后/2中期I/3减数I后/4中期II/5减数II后。DNA复制不使染色体数加倍。",
          "en": "Respect the documented model assumptions and parameter bounds."
        }
