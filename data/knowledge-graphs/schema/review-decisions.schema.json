{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primoria.local/schemas/review-decisions.schema.json",
  "title": "Primoria KG Human Review Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decisions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "$defs": {
    "reviewStatus": {
      "enum": ["unreviewed", "needs_review", "approved", "rejected", "superseded"]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^src_[a-z0-9_]+$" },
        "locator": { "type": "string", "minLength": 1 },
        "note_zh": { "type": "string", "minLength": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "target_type",
        "target_id",
        "from_status",
        "to_status",
        "reviewer_type",
        "reviewer_id",
        "reviewer_name",
        "reviewed_at",
        "rationale_zh",
        "evidence_refs"
      ],
      "properties": {
        "decision_id": { "type": "string", "pattern": "^review_[a-z0-9_]+$" },
        "target_type": {
          "enum": [
            "graph",
            "node",
            "edge",
            "cross_graph",
            "cross_edge",
            "canonical_concept",
            "curriculum_framework",
            "curriculum_requirement",
            "curriculum_mapping_set",
            "curriculum_mapping",
            "curriculum_gap_set",
            "curriculum_gap_candidate",
            "curriculum_gap_resolution_set",
            "curriculum_gap_resolution",
            "curriculum_practice_set",
            "curriculum_practice_item",
            "pedagogy_profile_set",
            "pedagogy_profile",
            "pedagogy_misconception",
            "pedagogy_instructional_strategy",
            "pedagogy_assessment_probe"
          ]
        },
        "target_id": { "type": "string", "minLength": 3 },
        "from_status": { "$ref": "#/$defs/reviewStatus" },
        "to_status": { "enum": ["approved", "rejected", "superseded"] },
        "reviewer_type": { "const": "human" },
        "reviewer_id": { "type": "string", "minLength": 1 },
        "reviewer_name": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "rationale_zh": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "to_status": { "const": "approved" } }, "required": ["to_status"] },
          "then": { "properties": { "evidence_refs": { "type": "array", "minItems": 1 } } }
        }
      ]
    }
  }
}
