{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primoria.local/schemas/curriculum-concept-mappings.schema.json",
  "title": "Primoria Curriculum to Canonical Concept Mappings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "mapping_set_id",
    "framework_id",
    "curriculum_id",
    "subject",
    "mapping_scope",
    "source_ids",
    "generated_at",
    "review_status",
    "changelog",
    "mappings"
  ],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "content_version": { "$ref": "#/$defs/semver" },
    "mapping_set_id": { "type": "string", "pattern": "^cms_[a-z0-9_]+$" },
    "framework_id": { "type": "string", "pattern": "^cfw_[a-z0-9_]+$" },
    "curriculum_id": { "type": "string", "pattern": "^cur_[a-z0-9_]+$" },
    "subject": { "type": "string", "minLength": 1 },
    "mapping_scope": { "enum": ["topic_alignment", "outcome_coverage"] },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceId" }
    },
    "generated_at": { "type": "string", "format": "date" },
    "review_status": { "$ref": "#/$defs/reviewStatus" },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "summary_zh"],
        "properties": {
          "version": { "$ref": "#/$defs/semver" },
          "date": { "type": "string", "format": "date" },
          "summary_zh": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sourceId": { "type": "string", "pattern": "^src_[a-z0-9_]+$" },
    "requirementId": { "type": "string", "pattern": "^req_[a-z0-9_]+$" },
    "canonicalId": { "type": "string", "pattern": "^pc_[a-f0-9]{32}$" },
    "reviewStatus": {
      "enum": ["unreviewed", "needs_review", "approved", "rejected", "superseded"]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "locator": { "type": "string", "minLength": 1 },
        "note_zh": { "type": "string", "minLength": 1 }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id",
        "requirement_id",
        "canonical_ids",
        "coverage_status",
        "relation",
        "mapping_basis",
        "confidence",
        "rationale_zh",
        "evidence_refs",
        "review_status"
      ],
      "properties": {
        "mapping_id": { "type": "string", "pattern": "^map_[a-z0-9_]+$" },
        "requirement_id": { "$ref": "#/$defs/requirementId" },
        "canonical_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalId" }
        },
        "coverage_status": { "enum": ["full", "partial", "unmapped", "excluded"] },
        "relation": { "enum": ["required", "supporting", "extension", "not_applicable"] },
        "mapping_basis": { "enum": ["explicit_term", "semantic_inference"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "rationale_zh": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "review_status": { "$ref": "#/$defs/reviewStatus" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "coverage_status": { "enum": ["full", "partial"] } },
            "required": ["coverage_status"]
          },
          "then": {
            "properties": {
              "canonical_ids": { "type": "array", "minItems": 1 },
              "relation": { "enum": ["required", "supporting", "extension"] }
            }
          }
        },
        {
          "if": {
            "properties": { "coverage_status": { "enum": ["unmapped", "excluded"] } },
            "required": ["coverage_status"]
          },
          "then": {
            "properties": {
              "canonical_ids": { "type": "array", "maxItems": 0 },
              "relation": { "const": "not_applicable" }
            }
          }
        }
      ]
    }
  }
}
