{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primoria.local/schemas/concept-registry.schema.json",
  "title": "Primoria Canonical Concept Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "concepts", "redirects"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date" },
    "concepts": {
      "type": "array",
      "items": { "$ref": "#/$defs/concept" }
    },
    "redirects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_canonical_id", "to_canonical_id", "reason_zh"],
        "properties": {
          "from_canonical_id": { "$ref": "#/$defs/canonicalId" },
          "to_canonical_id": { "$ref": "#/$defs/canonicalId" },
          "reason_zh": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "canonicalId": { "type": "string", "pattern": "^pc_[a-f0-9]{32}$" },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "preferred_name", "preferred_name_zh", "status", "review_status", "aliases"],
      "properties": {
        "canonical_id": { "$ref": "#/$defs/canonicalId" },
        "preferred_name": { "type": "string", "minLength": 1 },
        "preferred_name_zh": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "superseded"] },
        "review_status": { "enum": ["unreviewed", "needs_review", "approved", "rejected", "superseded"] },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["graph_id", "node_id"],
            "properties": {
              "graph_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "node_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
