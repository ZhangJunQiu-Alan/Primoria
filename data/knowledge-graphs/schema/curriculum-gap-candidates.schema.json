{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primoria.local/schemas/curriculum-gap-candidates.schema.json",
  "title": "Primoria Curriculum KG Gap Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "gap_set_id",
    "framework_id",
    "curriculum_id",
    "subject",
    "source_ids",
    "generated_at",
    "review_status",
    "changelog",
    "candidates"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "content_version": { "$ref": "#/$defs/semver" },
    "gap_set_id": { "type": "string", "pattern": "^cgs_[a-z0-9_]+$" },
    "framework_id": { "type": "string", "pattern": "^cfw_[a-z0-9_]+$" },
    "curriculum_id": { "type": "string", "pattern": "^cur_[a-z0-9_]+$" },
    "subject": { "type": "string", "minLength": 1 },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceId" }
    },
    "generated_at": { "type": "string", "format": "date" },
    "review_status": { "$ref": "#/$defs/reviewStatus" },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "summary_zh"],
        "properties": {
          "version": { "$ref": "#/$defs/semver" },
          "date": { "type": "string", "format": "date" },
          "summary_zh": { "type": "string", "minLength": 1 }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sourceId": { "type": "string", "pattern": "^src_[a-z0-9_]+$" },
    "requirementId": { "type": "string", "pattern": "^req_[a-z0-9_]+$" },
    "canonicalId": { "type": "string", "pattern": "^pc_[a-f0-9]{32}$" },
    "reviewStatus": {
      "enum": ["unreviewed", "needs_review", "approved", "rejected", "superseded"]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "locator": { "type": "string", "minLength": 1 },
        "note_zh": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "requirement_ids",
        "action",
        "proposed_name",
        "proposed_name_zh",
        "scope_zh",
        "existing_canonical_ids",
        "suggested_graph_id",
        "rationale_zh",
        "evidence_refs",
        "review_status"
      ],
      "properties": {
        "gap_id": { "type": "string", "pattern": "^gap_[a-z0-9_]+$" },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirementId" }
        },
        "action": {
          "enum": ["add_concept", "split_or_narrow_existing", "not_knowledge_concept"]
        },
        "proposed_name": { "type": "string", "minLength": 1 },
        "proposed_name_zh": { "type": "string", "minLength": 1 },
        "scope_zh": { "type": "string", "minLength": 1 },
        "existing_canonical_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalId" }
        },
        "suggested_graph_id": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z0-9_]+$" },
            { "type": "null" }
          ]
        },
        "rationale_zh": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "review_status": { "$ref": "#/$defs/reviewStatus" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "add_concept" } }, "required": ["action"] },
          "then": {
            "properties": {
              "existing_canonical_ids": { "type": "array", "maxItems": 0 },
              "suggested_graph_id": { "type": "string" }
            }
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "split_or_narrow_existing" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "existing_canonical_ids": { "type": "array", "minItems": 1 },
              "suggested_graph_id": { "type": "string" }
            }
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "not_knowledge_concept" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "existing_canonical_ids": { "type": "array", "maxItems": 0 },
              "suggested_graph_id": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
