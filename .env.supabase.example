# Copy to .env.supabase; keep actual credentials out of version control.
# Runtime traffic uses the Transaction pooler (6543) so per-process pools can
# grow without exhausting the Session pooler's per-role client limit.
# Migrations stay on the Session pooler (5432): the KG migration holds a
# session advisory lock.
SUPABASE_PROJECT_REF=your-project-ref
DATABASE_URL=postgresql://primoria_runtime.your-project-ref:URL_ENCODED_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=verify-full
DATABASE_MIGRATION_URL=postgresql://primoria_migrator.your-project-ref:URL_ENCODED_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full
DATABASE_SSL=verify-full
# Optional override; empty sizes pools from DATABASE_URL (1 on 5432, 5 on 6543).
# DATABASE_POOL_MAX=
NODE_EXTRA_CA_CERTS=docker/certs/supabase-prod-ca-2021.crt
