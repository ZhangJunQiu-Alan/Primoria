# Copy to .env.supabase; keep actual credentials out of version control.
# Use the Supabase Session pooler on port 5432 (not transaction port 6543).
SUPABASE_PROJECT_REF=your-project-ref
DATABASE_URL=postgresql://primoria_runtime.your-project-ref:URL_ENCODED_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full
DATABASE_MIGRATION_URL=postgresql://primoria_migrator.your-project-ref:URL_ENCODED_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=1
NODE_EXTRA_CA_CERTS=docker/certs/supabase-prod-ca-2021.crt

# Lesson image bytes live in a private Storage bucket of the same project.
# Server-side only (Web + lesson worker): a secret key (sb_secret_...) or the
# legacy service_role key. Unset keeps image bytes in Postgres.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
PRIMORIA_MEDIA_BUCKET=lesson-media
