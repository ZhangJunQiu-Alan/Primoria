# TLS-terminating reverse proxy in front of the web app. With PRIMORIA_DOMAIN
# set, Caddy provisions and renews Let's Encrypt certificates automatically
# (ports 80+443 must be open in the server's security group). Without it, the
# site is served on plain :80.
{$PRIMORIA_DOMAIN} {
	encode gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	reverse_proxy web:3000
}
