# Production environment for docker-compose.prod.yml.
# On the server:  cp .env.production.example .env  and fill in every "replace-*".
# This one file feeds all containers (web, agent, workers, migrate) and the
# compose build args. Do NOT commit the filled-in .env.

# ── Postgres ────────────────────────────────────────────────────────────────
# Used both by the postgres container and interpolated into DATABASE_URL.
# Keep it URL-safe (letters/digits only) — it is embedded in a connection URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ── Domain / TLS ────────────────────────────────────────────────────────────
# Your domain (DNS A record → server IP). Caddy then auto-provisions HTTPS.
# Leave empty to serve plain HTTP on :80 while testing with a bare IP.
PRIMORIA_DOMAIN=
# Public origin of the app; must match PRIMORIA_DOMAIN when set.
APP_BASE_URL=https://replace-with-your-domain
NEXT_PUBLIC_APP_URL=https://replace-with-your-domain
# Cloudflare Turnstile (optional). Baked into the client bundle at build time —
# rebuild the web image after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Model provider ──────────────────────────────────────────────────────────
# On a mainland-China server, direct DeepSeek/MiniMax endpoints work (it is
# campus/office DNS that blocks them), while OpenRouter is unreliable from the
# mainland — prefer direct provider endpoints here.
AI_PROVIDER=openai-compatible
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=deepseek-v4-pro
# Fast tier for chat/utility calls.
AI_MODEL_FAST=deepseek-v4-flash

# ── KG embeddings ───────────────────────────────────────────────────────────
# Keep embeddings independent from the DeepSeek chat endpoint above.
KG_EMBEDDING_PROVIDER=minimax
MINIMAX_API_KEY=replace-with-your-minimax-key
MINIMAX_GROUP_ID=
MINIMAX_EMBEDDING_BASE_URL=https://api.minimax.chat/v1
MINIMAX_EMBEDDING_MODEL=embo-01
KG_EMBEDDING_MODEL_VERSION=minimax:embo-01:1536
# OpenAI-compatible alternative (must expose POST /embeddings):
# KG_EMBEDDING_PROVIDER=openai-compatible
# KG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# KG_EMBEDDING_API_KEY=replace-with-your-embedding-key
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# KG_EMBEDDING_MODEL_VERSION=openai:text-embedding-3-small:1536

# ── KG positioning ──────────────────────────────────────────────────────────
KG_POSITION_TAU=0.6
KG_POSITION_FLOOR=0.28
KG_BROAD_MENU_SIMILARITY_WINDOW=0.1
KG_ROUTER_MODEL=

# ── Auth rate limiting ──────────────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_IP_MAX=5
AUTH_RATE_LIMIT_ACCOUNT_MAX=5
# In this compose topology the web app only ever sees Caddy's IP; Caddy
# overwrites X-Forwarded-For with the real client IP, so trust exactly that
# header. Remove this line if you strip Caddy out of the stack.
AUTH_RATE_LIMIT_CLIENT_IP_HEADER=x-forwarded-for

# ── Password reset email (Tencent Cloud SES) ────────────────────────────────
EMAIL_PROVIDER=tencent-ses
TENCENT_SES_SECRET_ID=replace-with-secret-id
TENCENT_SES_SECRET_KEY=replace-with-secret-key
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_ENDPOINT=ses.tencentcloudapi.com
TENCENT_SES_FROM_EMAIL="Primoria <noreply@example.com>"
TENCENT_SES_PASSWORD_RESET_TEMPLATE_ID=123456
TENCENT_SES_PASSWORD_RESET_SUBJECT="Reset your Primoria password"
PASSWORD_RESET_EXPIRES_MINUTES=30

# ── Health / operations ─────────────────────────────────────────────────────
# GET /api/health flips to "degraded" when a queued job waits longer than this
# (usually a dead worker). Point an uptime probe at /api/health and keyword-
# match "status":"ok".
PRIMORIA_HEALTH_QUEUE_STALL_SECONDS=600

# Never enable in production:
# PRIMORIA_ALLOW_KG_INFRA_FALLBACK=1
# PRIMORIA_ENABLE_QA_ROUTES=1
