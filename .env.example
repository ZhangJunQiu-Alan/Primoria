# Primoria shared env file loaded by run.sh / run.ps1
# For local Supabase, keep this URL unless your stack uses a different port.
SUPABASE_URL=http://127.0.0.1:54321

# Required by Builder and Viewer. Fill this from your Supabase project or local stack.
SUPABASE_ANON_KEY=

# Optional explicit Builder vars.
# If omitted, run.sh maps SUPABASE_URL and SUPABASE_ANON_KEY to VITE_* automatically.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Agent Service endpoint used by Viewer AI features.
# If omitted, run.sh maps AGENT_SERVICE_URL to VITE_AGENT_SERVICE_URL automatically.
AGENT_SERVICE_URL=http://127.0.0.1:8787
# VITE_AGENT_SERVICE_URL=

### Supabase OAuth provider credentials (used by supabase/config.toml via env())
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

### Do NOT commit service role key
# SUPABASE_SERVICE_ROLE_KEY=

### Unified model API service (do not commit secrets)
# All Viewer AI model calls should go through agent-service, not browser-side provider calls.
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_BASE_URL=

### Provider-specific overrides
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com

### Agent defaults
AGENT_MODEL=gemini-2.5-flash
MEMORY_SUMMARY_MODEL=gemini-2.5-flash
