### Supabase (public values; safe to ship anon key)
SUPABASE_URL=
SUPABASE_ANON_KEY=

### Supabase OAuth provider credentials (used by supabase/config.toml via env())
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

### Do NOT commit service role key
# SUPABASE_SERVICE_ROLE_KEY=

### Gemini (do not commit)
GEMINI_API_KEY=
